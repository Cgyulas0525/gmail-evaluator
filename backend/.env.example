APP_NAME="Gmail Evaluator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:28088

SANCTUM_STATEFUL_DOMAINS=localhost:28088,localhost:5173,127.0.0.1:28088,127.0.0.1:5173
SESSION_DOMAIN=localhost

AUTH_DEFAULT_NAME="Admin"
AUTH_DEFAULT_EMAIL=admin@gmailevaluator.local
AUTH_DEFAULT_PASSWORD=password

APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=hu_HU

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gmail_eval
DB_USERNAME=gmail_user
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GEMINI_API_KEY=

AUTO_REPLY_ENABLED=false
AUTO_REPLY_CATEGORIES=billing,work

VITE_APP_NAME="${APP_NAME}"
